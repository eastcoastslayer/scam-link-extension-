{
  "manifest_version": 3,
  "name": "Scam Link Detector",
  "version": "1.1.0",
  "description": "Advanced browser security extension that detects scam links, clickbait, phishing, fake ads, suspicious downloads, and dangerous websites.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scam Link Detector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "scam_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
